# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Firebase Admin (produção: service account JSON ou ADC)
# Opção A: caminho para arquivo de service account
GOOGLE_APPLICATION_CREDENTIALS=
# Opção B: JSON inline (base64) — usado em alguns hosts
FIREBASE_SERVICE_ACCOUNT_JSON=
# Projeto GCP
FIREBASE_PROJECT_ID=

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,https://presentesempre.web.app

# Emuladores (dev)
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=